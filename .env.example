# Voice Prescription Writer - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# STT (Speech-to-Text) Provider Configuration
# =============================================================================
# Options: "google", "deepgram", "mock"
STT_PROVIDER=mock

# Google Cloud Speech-to-Text
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Deepgram
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Options: "openai", "gemini", "mock"
LLM_PROVIDER=mock

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-pro

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Database Configuration
# =============================================================================
# Primary Production Target: PostgreSQL with asyncpg connection pooling
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_prescriptions

# Local Development / Test Default: SQLite
DATABASE_URL=sqlite:///./data/prescriptions.db
DATABASE_PATH=./data/prescriptions.db

# Database Migration note:
# Run: python backend/scripts/migrate_sqlite_to_pg.py --sqlite ./data/prescriptions.db --pg postgresql://user:pass@localhost:5432/voice_prescriptions
# Strict Database Engine Mode: If a postgresql:// URL is provided, the application strictly
# connects to PostgreSQL and will never silently fall back to SQLite.

# File Storage
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./pdf_output

# =============================================================================
# Security
# =============================================================================
# Secret key for signing (generate a random one)
SECRET_KEY=change-this-to-a-random-secret-key

